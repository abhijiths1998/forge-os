# Arch Linux build environment for producing the forge-os ISO.
# Runs archiso's mkarchiso, since archiso only works on Arch itself
# and the host machine here is Fedora/Nobara-based.
FROM archlinux:base-devel

RUN pacman -Syu --noconfirm --needed \
        archiso \
        git \
        dosfstools \
        squashfs-tools \
        libisoburn \
        edk2-ovmf \
    && pacman -Scc --noconfirm

# Bootstrap Chaotic-AUR on the BUILD HOST (this container), not just in the
# ISO's own pacman.conf. mkarchiso resolves the profile's pacman.conf with
# `pacman-conf` before pacstrap ever runs, which means the repo's
# `Include = /etc/pacman.d/chaotic-mirrorlist` file must already exist on
# this filesystem, and pacstrap verifies package signatures against this
# container's pacman keyring. Without this, pacstrap fails outright on any
# chaotic-aur-only package (e.g. calamares, proton-ge-custom) in
# packages.x86_64.
RUN pacman-key --init \
    && pacman-key --populate archlinux \
    && pacman-key --recv-key 3056513887B78AEB --keyserver keyserver.ubuntu.com \
    && pacman-key --lsign-key 3056513887B78AEB \
    && pacman -U --noconfirm \
        'https://cdn-mirror.chaotic.cx/chaotic-aur/chaotic-keyring.pkg.tar.zst' \
        'https://cdn-mirror.chaotic.cx/chaotic-aur/chaotic-mirrorlist.pkg.tar.zst'

# calamares itself is on neither the official repos nor Chaotic-AUR (every
# distro that uses it ships its own build in its own repo), so build it once
# here from its AUR PKGBUILD and serve it from a local file:// repo that
# profile/pacman.conf points pacstrap at during the ISO build.
RUN pacman -S --noconfirm --needed \
        extra-cmake-modules kcoreaddons kpmcore libpwquality \
        qt6-declarative qt6-svg yaml-cpp libglvnd ninja qt6-tools \
        qt6-translations cmake \
    && useradd -m builder \
    && su builder -c ' \
        set -e; \
        cd /tmp; \
        git clone --depth 1 https://aur.archlinux.org/calamares.git; \
        cd calamares; \
        makepkg --noconfirm --skippgpcheck \
    ' \
    && mkdir -p /var/cache/forge-os-local-repo \
    && cp /tmp/calamares/*.pkg.tar.zst /var/cache/forge-os-local-repo/ \
    && repo-add /var/cache/forge-os-local-repo/forge-os-local.db.tar.gz \
        /var/cache/forge-os-local-repo/*.pkg.tar.zst \
    && userdel -r builder \
    && rm -rf /tmp/calamares

# WhiteSur icons (https://github.com/vinceliuice/WhiteSur-icon-theme), the
# app icons Forge Glass uses: not on Chaotic-AUR either, so built from AUR
# the same way as calamares. An asset package, so this is fast.
# TERM must be set: WhiteSur's install.sh calls `setterm` for its spinner
# animation, which fails outright (aborting under set -e) with no TTY/TERM,
# as Docker RUN steps have.
RUN pacman -Syu --noconfirm --needed sassc which gtk3 ncurses \
    && useradd -m builder \
    && su builder -c ' \
        set -e; \
        export TERM=xterm; \
        cd /tmp; \
        git clone --depth 1 https://aur.archlinux.org/whitesur-icon-theme.git; \
        cd whitesur-icon-theme; \
        makepkg --noconfirm --skippgpcheck \
    ' \
    && cp /tmp/whitesur-icon-theme/*.pkg.tar.zst /var/cache/forge-os-local-repo/ \
    && repo-add /var/cache/forge-os-local-repo/forge-os-local.db.tar.gz \
        /var/cache/forge-os-local-repo/*.pkg.tar.zst \
    && userdel -r builder \
    && rm -rf /tmp/whitesur-icon-theme

# NVIDIA pinned to 610.57.04: 615.78.08 hard-freezes the RTX 3050 laptop in
# games (GTA 5, Witcher 3; on both linux and linux-zen), and 610 doesn't.
# The Arch Linux Archive keeps the old builds; the local repo is listed
# first in profile/pacman.conf, so these win over extra/multilib. The
# shipped pacman.conf has them in IgnorePkg so -Syu doesn't undo it.
ARG NVIDIA_VERSION=610.57.04-1
RUN cd /var/cache/forge-os-local-repo \
    && for pkg in nvidia-open-dkms nvidia-utils lib32-nvidia-utils \
            nvidia-settings opencl-nvidia; do \
        curl -fLO "https://archive.archlinux.org/packages/${pkg:0:1}/${pkg}/${pkg}-${NVIDIA_VERSION}-x86_64.pkg.tar.zst" \
            || exit 1; \
    done \
    && repo-add /var/cache/forge-os-local-repo/forge-os-local.db.tar.gz \
        /var/cache/forge-os-local-repo/*.pkg.tar.zst

# kwin-effects-glass (the Forge Glass frosting). Chaotic-AUR has it, but
# KWin bakes its exact version into the effect plugin interface and refuses
# a plugin built against any other ("Effect "glass" was built for a
# different version of KWin"), and Chaotic's build often lags a KWin point
# release. So build it here against the KWin the ISO will ship; the local
# repo is listed first in profile/pacman.conf, so this build wins.
# build.sh passes KWIN_VERSION (Arch's current kwin) so a KWin update
# invalidates this layer and the effect is rebuilt to match.
# pkgrel=100 keeps our package's filename distinct from Chaotic's same-
# version build (they'd collide in the shared pacman cache volume and fail
# the checksum), and stops an installed system "upgrading" to Chaotic's
# build of the same commit; a newer upstream commit still replaces it.
ARG KWIN_VERSION=unknown
RUN echo "building kwin-effects-glass against kwin ${KWIN_VERSION}" \
    && pacman -Syu --noconfirm --needed \
        kwin kio knotifications kcrash kglobalaccel kcmutils libepoxy \
        extra-cmake-modules qt6-tools vulkan-headers cmake git \
    && useradd -m builder \
    && su builder -c ' \
        set -e; \
        cd /tmp; \
        git clone --depth 1 https://aur.archlinux.org/kwin-effects-glass-git.git; \
        cd kwin-effects-glass-git; \
        makepkg --nobuild --noconfirm --skippgpcheck; \
        sed -i "s/^pkgrel=.*/pkgrel=100/" PKGBUILD; \
        makepkg --noextract --noconfirm --skippgpcheck \
    ' \
    && cp /tmp/kwin-effects-glass-git/*.pkg.tar.zst /var/cache/forge-os-local-repo/ \
    && repo-add /var/cache/forge-os-local-repo/forge-os-local.db.tar.gz \
        /var/cache/forge-os-local-repo/*.pkg.tar.zst \
    && userdel -r builder \
    && rm -rf /tmp/kwin-effects-glass-git

# Toolchains and build dependencies for the Forge apps (apps/), which
# apps/build-packages.sh builds at ISO build time: Flutter (Chaotic-AUR) and
# GTK for the launcher and store, gtk-layer-shell for Forge Control,
# libpamac for the store, Qt WebEngine for the browser; and for Forge's own
# Konsole build (packages/konsole), Konsole itself (for the libraries it
# links) with extra-cmake-modules and kdoctools. A layer of its own so a
# Flutter or Qt update only redoes this.
# flutter-bin and pamac are Chaotic-AUR packages, so this container's own
# pacman.conf gets that repo too (the keyring and mirrorlist are set up above).
RUN grep -q "^\[chaotic-aur\]" /etc/pacman.conf \
        || printf "\n[chaotic-aur]\nInclude = /etc/pacman.d/chaotic-mirrorlist\n" \
            >> /etc/pacman.conf \
    && pacman -Syu --noconfirm --needed \
        flutter-bin cmake ninja clang pkgconf gtk3 gtk-layer-shell pamac \
        qt6-base qt6-webengine glycin libjxl \
        konsole extra-cmake-modules kdoctools \
    && pacman -Scc --noconfirm

WORKDIR /build
