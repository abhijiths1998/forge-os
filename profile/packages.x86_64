# --- forge-os additions below (see docs/ROADMAP.md for rationale) ---

# Kernels (stock + zen fallback; CachyOS kernel deferred, see ROADMAP)
linux-headers
linux-zen
linux-zen-headers

# NVIDIA (open kernel modules: NVIDIA's default for Turing/2018+ GPUs.
# Legacy proprietary drivers for pre-Turing cards are chaotic-aur-only
# version-pinned packages, e.g. nvidia-470xx-dkms; deferred, see ROADMAP)
nvidia-open-dkms
nvidia-utils
lib32-nvidia-utils
nvidia-settings
egl-wayland
vulkan-icd-loader
lib32-vulkan-icd-loader
libva-nvidia-driver
# AMD and Intel GPUs: Vulkan (64- and 32-bit, which Proton needs) and
# hardware video decode. Without these, games don't start on non-NVIDIA
# machines; mesa alone only brings OpenGL.
vulkan-radeon
lib32-vulkan-radeon
vulkan-intel
lib32-vulkan-intel
intel-media-driver
# Codecs, as Nobara ships them: gstreamer is what KDE apps, Lutris/Wine
# games' cutscenes and web video in Qt apps play through.
gst-plugins-good
gst-plugins-bad
gst-plugins-ugly
gst-libav

# KDE Plasma desktop: plasma-meta (shell/workspace) + a curated set of
# apps, not kde-applications-meta (which drags in the entire KDE
# Applications release - office suite, education apps, kdevelop, games...
# far more than a gaming/desktop spin needs).
plasma-meta
dolphin
dolphin-plugins
konsole
kate
ark
gwenview
okular
spectacle
kcalc
kdeconnect
filelight
partitionmanager
ffmpegthumbs
kdegraphics-thumbnailers
kimageformats
print-manager
sddm
xdg-desktop-portal-kde
pipewire
pipewire-alsa
pipewire-pulse
pipewire-jack
wireplumber
networkmanager
plasma-nm
# VPN protocol plugins: NetworkManager itself was already here, but without
# these its Plasma applet has no way to actually configure a VPN connection
# (WireGuard needs no plugin, just the userspace tools - NM has supported it
# natively since 1.16).
networkmanager-openvpn
networkmanager-vpnc
networkmanager-openconnect
wireguard-tools
bluez
bluez-utils
kwalletmanager

# Forge Glass default look (pastel liquid glass; see docs/ROADMAP.md). The
# theme itself (look-and-feel, colour schemes, wallpaper, SDDM theme,
# Plymouth) is forge-os's own and ships in the airootfs overlay; these are
# the pieces it builds on:
# - whitesur-icon-theme: the rounded-square app icons (built from AUR, see
#   build/Containerfile; its Apple start-here icons get replaced in
#   customize_airootfs.sh)
# - ttf-jetbrains-mono-nerd: terminal type
# - kwin-effect-rounded-corners-git: rounded window corners
# - kwin-effects-glass-git: frosted/liquid glass (blur, refraction, edge
#   lighting) behind every translucent surface; replaces the stock blur
# - darkly-qt6-git: widget style + window decoration that makes app windows
#   translucent (the ForgeGlass colour schemes carry the alpha)
# - kwin-polonium: auto-tiling, off by default (`forge tile on`)
# The UI font, Plus Jakarta Sans, isn't packaged; it ships in
# airootfs/usr/share/fonts/plus-jakarta-sans.
whitesur-icon-theme
ttf-jetbrains-mono-nerd
kwin-effect-rounded-corners-git
kwin-effects-glass-git
darkly-qt6-git
kwin-polonium

# Forge Launcher (apps/forge-launcher, built into the local repo by
# apps/build-packages.sh): the Meta+Space command bar, in place of KRunner.
forge-launcher

# Default shell: zsh + Oh My Zsh (for its plugins; the prompt is our own,
# see /etc/skel/.zshrc) + autosuggestions/syntax-highlighting.
oh-my-zsh-git
zsh-completions
zsh-autosuggestions
zsh-syntax-highlighting

# App store (Pamac, not Discover: native repo browsing across
# core/extra/multilib/Chaotic-AUR plus Flatpak, in one Manjaro/Garuda-style
# GUI, rather than KDE's more limited Flatpak/pacman-only Discover)
pamac

# Default browser
brave-bin

# Gaming stack
steam
lutris
heroic-games-launcher-bin
wine-staging
winetricks
gamemode
lib32-gamemode
mangohud
lib32-mangohud
goverlay
gamescope
vkbasalt
lib32-vkbasalt
discord
game-devices-udev
# Xbox One/Series controllers over Bluetooth (rumble, correct mapping)
xpadneo-dkms
protonup-qt

# SteamOS-style Big Picture session, selectable from the SDDM login screen
# (Session dropdown) alongside the normal Plasma session.
gamescope-session-git
gamescope-session-steam-git

# Snapshots / rollback safety net (btrfs-progs already listed above)
snapper
grub-btrfs
inotify-tools

# System niceties
flatpak
zram-generator
ananicy-cpp
# ananicy-cpp ships no rules of its own: without these it runs and does
# nothing. CachyOS's set covers games, launchers, compilers and desktops.
cachyos-ananicy-rules-git
# Power Saver / Balanced / Performance in Plasma's battery applet
power-profiles-daemon
irqbalance
fwupd
sbctl
plymouth
chaotic-keyring
chaotic-mirrorlist
calamares
