# --- forge-os additions below (see docs/ROADMAP.md for rationale) ---

# Kernels (stock + zen fallback; CachyOS kernel deferred, see ROADMAP)
linux-headers
linux-zen
linux-zen-headers

# NVIDIA (open kernel modules: NVIDIA's default for Turing/2018+ GPUs.
# Legacy proprietary drivers for pre-Turing cards are chaotic-aur-only
# version-pinned packages, e.g. nvidia-470xx-dkms; deferred, see ROADMAP)
nvidia-open-dkms
nvidia-utils
lib32-nvidia-utils
nvidia-settings
egl-wayland
vulkan-icd-loader
lib32-vulkan-icd-loader

# KDE Plasma desktop: plasma-meta (shell/workspace) + a curated set of
# apps, not kde-applications-meta (which drags in the entire KDE
# Applications release - office suite, education apps, kdevelop, games...
# far more than a gaming/desktop spin needs).
plasma-meta
dolphin
dolphin-plugins
konsole
kate
ark
gwenview
okular
spectacle
kcalc
kdeconnect
filelight
partitionmanager
ffmpegthumbs
kdegraphics-thumbnailers
kimageformats
print-manager
sddm
xdg-desktop-portal-kde
pipewire
pipewire-alsa
pipewire-pulse
pipewire-jack
wireplumber
networkmanager
plasma-nm
bluez
bluez-utils
kwalletmanager

# macOS-style default look (WhiteSur, github.com/vinceliuice/WhiteSur-*):
# global theme/color-scheme/window-decoration/SDDM theme, icons, and a
# matching GTK theme so non-Qt apps (browsers, Pamac) don't clash. Not
# packaged anywhere (not even Chaotic-AUR) so it's built from AUR the same
# way as calamares, see build/Containerfile. mcmojave-cursors-git is a
# separate, already-packaged macOS-style cursor set.
whitesur-gtk-theme
whitesur-icon-theme
whitesur-kde-theme
mcmojave-cursors-git

# Default shell: zsh + Oh My Zsh + autosuggestions/syntax-highlighting.
# ttf-meslo-nerd provides the glyphs the "agnoster" theme needs (see
# /etc/skel/.zshrc and the Konsole default profile).
oh-my-zsh-git
zsh-completions
zsh-autosuggestions
zsh-syntax-highlighting
ttf-meslo-nerd

# App store (Pamac, not Discover: native repo browsing across
# core/extra/multilib/Chaotic-AUR plus Flatpak, in one Manjaro/Garuda-style
# GUI, rather than KDE's more limited Flatpak/pacman-only Discover)
pamac

# Default browser
brave-bin

