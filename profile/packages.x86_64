# --- forge-os additions below (see docs/ROADMAP.md for rationale) ---

# Kernels (stock + zen fallback; CachyOS kernel deferred, see ROADMAP)
linux-headers
linux-zen
linux-zen-headers

# NVIDIA (open kernel modules: NVIDIA's default for Turing/2018+ GPUs.
# Legacy proprietary drivers for pre-Turing cards are chaotic-aur-only
# version-pinned packages, e.g. nvidia-470xx-dkms; deferred, see ROADMAP)
nvidia-open-dkms
nvidia-utils
lib32-nvidia-utils
nvidia-settings
egl-wayland
vulkan-icd-loader
lib32-vulkan-icd-loader
libva-nvidia-driver
# AMD and Intel GPUs: Vulkan (64- and 32-bit, which Proton needs) and
# hardware video decode. Without these, games don't start on non-NVIDIA
# machines; mesa alone only brings OpenGL.
vulkan-radeon
lib32-vulkan-radeon
vulkan-intel
lib32-vulkan-intel
intel-media-driver
# Codecs, as Nobara ships them: gstreamer is what KDE apps, Lutris/Wine
# games' cutscenes and web video in Qt apps play through.
gst-plugins-good
gst-plugins-bad
gst-plugins-ugly
gst-libav

# The desktop is Hyprland with Forge's shell (forge-session, forge-shell,
# below; docs/HYPRLAND.md). KDE Plasma and its apps are gone: Forge's own
# apps and these stopgaps cover what they did, until Forge versions exist.
# Konsole stays until Forge Terminal's rewrite (milestone 5).
konsole
gnome-text-editor
file-roller
loupe
papers
gnome-calculator
gparted
system-config-printer
cups
seahorse
ffmpegthumbnailer
qt6-imageformats
sddm
pipewire
pipewire-alsa
pipewire-pulse
pipewire-jack
wireplumber
networkmanager
# VPN protocol plugins: NetworkManager itself was already here, but without
# these nm-connection-editor has no way to actually configure a VPN connection
# (WireGuard needs no plugin, just the userspace tools - NM has supported it
# natively since 1.16).
networkmanager-openvpn
networkmanager-vpnc
networkmanager-openconnect
wireguard-tools
bluez
bluez-utils

# Forge Theming Kit (apps/forge-themekit, built into the local repo by
# apps/build-packages.sh): themes and sliders for colour and liquid glass.
forge-themekit

# Forge Glass (pastel liquid glass; Hyprland draws the glass itself, see
# forge-session's look.lua). The pieces it builds on:
# - whitesur-icon-theme: the rounded-square app icons (built from AUR, see
#   build/Containerfile; its Apple start-here icons get replaced in
#   customize_airootfs.sh)
# - ttf-jetbrains-mono-nerd: terminal type, and the shell's icons
# The UI font, Plus Jakarta Sans, isn't packaged; it ships in
# airootfs/usr/share/fonts/plus-jakarta-sans.
whitesur-icon-theme
ttf-jetbrains-mono-nerd

# Forge's Hyprland session (forge-session, apps/forge-session): Hyprland
# started through uwsm, Forge's defaults in /usr/share/forge/hypr, the
# portals, polkit agent, idle/lock, clipboard history, auto-mount and the
# wallpaper. See docs/HYPRLAND.md.
forge-session
hyprland
uwsm
xdg-desktop-portal-hyprland
xdg-desktop-portal-gtk
hyprpolkitagent
hypridle
hyprlock
hyprpicker
hyprsunset
hyprland-guiutils
qt6-wayland
qt5-wayland
qt6ct
kvantum
adw-gtk-theme
adwaita-cursors
awww
grim
slurp
wl-clipboard
cliphist
wl-clip-persist
brightnessctl
playerctl
udiskie
gnome-keyring
libsecret
upower
jq
libnotify
xdg-user-dirs
xdg-terminal-exec
foot
btop
nm-connection-editor
network-manager-applet
blueman
nwg-displays
gpu-screen-recorder
noto-fonts
noto-fonts-emoji
noto-fonts-cjk

# Forge Launcher (apps/forge-launcher, built into the local repo by
# apps/build-packages.sh): the Meta+Space command bar, in place of KRunner.
forge-launcher

# Forge shell (apps/forge-shell, Quickshell): the bar, Control Center,
# notifications, OSDs, the desktop shortcut panel and the overlays.
forge-shell
quickshell
qt6-5compat
wtype
unicode-emoji

# Forge Settings (apps/forge-settings, Flutter on forge_ui): displays,
# keyboard, mouse, shortcuts with conflict detection, default apps, startup,
# sound, network/VPN, Bluetooth, users, about. Writes keybinds.user.lua and
# monitors.lua under ~/.config/hypr/.
forge-settings

# Forge Wallpapers (apps/forge-wallpapers, Flutter on forge_ui): the Forge
# cast wallpaper grid and online source stubs; swww/awww integration.
forge-wallpapers
awww

# Forge Code (packages/forge-code): Neovim with Forge's offline config.
neovim
forge-code

# Forge Thermal (apps/forge-thermal): the app for forge-thermal's cooling
# profiles and firmware limits.
forge-thermal

# Forge Shot (apps/forge-shot): screenshots, in place of Spectacle on the
# Print keys (Spectacle stays, for screen recording).
forge-shot

# Default shell: zsh + Oh My Zsh (for its plugins; the prompt is our own,
# see /etc/skel/.zshrc) + autosuggestions/syntax-highlighting.
oh-my-zsh-git
zsh-completions
zsh-autosuggestions
zsh-syntax-highlighting

# App store: Forge Store (apps/forge-store), in place of the Pamac GUI. It
# runs on libpamac and the pamac CLI, which `forge install` uses too (native
# repo browsing across core/extra/multilib/Chaotic-AUR, rather than KDE's
# more limited Flatpak/pacman-only Discover).
forge-store
pamac

# Default browser: Forge Browser (apps/forge-browser), with built-in ad
# blocking, and Widevine for DRM sites (Netflix, Spotify web), which Qt
# WebEngine doesn't ship. Brave stays as a second browser.
forge-browser
chromium-widevine
brave-bin

# Forge's everyday apps (apps/forge-terminal, forge-files, forge-calendar):
# Forge's terminal, file manager and calendar on Plasma, opening by default
# in place of Konsole and Dolphin (which stay installed). Videos and PDFs get
# thumbnails from ffmpeg and poppler.
forge-terminal
forge-files
forge-calendar
ffmpeg
poppler

# Gaming stack
steam
lutris
heroic-games-launcher-bin
wine-staging
winetricks
gamemode
lib32-gamemode
mangohud
lib32-mangohud
goverlay
gamescope
vkbasalt
lib32-vkbasalt
discord
game-devices-udev
# Xbox One/Series controllers over Bluetooth (rumble, correct mapping)
xpadneo-dkms
protonup-qt

# SteamOS-style Big Picture session, selectable from the SDDM login screen
# (Session dropdown) alongside the normal Plasma session.
gamescope-session-git
gamescope-session-steam-git

# Snapshots / rollback safety net (btrfs-progs already listed above)
snapper
grub-btrfs
inotify-tools

# System niceties
flatpak
zram-generator
ananicy-cpp
# ananicy-cpp ships no rules of its own: without these it runs and does
# nothing. CachyOS's set covers games, launchers, compilers and desktops.
cachyos-ananicy-rules-git
# Power Saver / Balanced / Performance in Plasma's battery applet
power-profiles-daemon
irqbalance
fwupd
sbctl
plymouth
chaotic-keyring
chaotic-mirrorlist
calamares

# Forge Mind (forge-mind): Python, its D-Bus and GObject bindings, and
# paccache for cleaning the package cache
python
python-dbus
python-gobject
pacman-contrib
# Forge Mind's local model runtime; the model itself is downloaded at install
# time (forge-mind-model). Vulkan, not CUDA: 40 MB instead of 6 GB, any GPU.
ollama
ollama-vulkan
