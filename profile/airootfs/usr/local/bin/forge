#!/usr/bin/env bash
# forge: one command for the everyday stuff on forge-os.
#
#   forge install <pkg...>    repo, Chaotic-AUR and AUR packages (via pamac)
#   forge remove <pkg...>
#   forge update              system packages + Flatpaks
#   forge search <query>
#   forge theme [light|dark|<theme>|list]
#                             Forge Glass light/dark (toggles if omitted), or any
#                             Theming Kit theme
#   forge tile [on|off]       Polonium auto-tiling (toggles if omitted)
#   forge glass [preset]      glass look: calm, liquid or bold (shows it if omitted)
#   forge thermal [profile]   CPU/GPU clock profile (shows temps if omitted)
#   forge about
set -uo pipefail

# Forge Glass palette, truecolour.
c() { printf '\e[38;2;%sm' "$1"; }
PERI="$(c '138;155;247')" GREEN="$(c '143;211;168')" ROSE="$(c '242;139;155')"
GREY="$(c '139;144;176')" LILAC="$(c '195;183;238')" BOLD=$'\e[1m' OFF=$'\e[0m'

say()  { printf '%s%s%s %s\n' "${PERI}" "forge" "${OFF}" "$*"; }
ok()   { printf '%s✓%s %s\n' "${GREEN}" "${OFF}" "$*"; }
fail() { printf '%s✗%s %s\n' "${ROSE}" "${OFF}" "$*" >&2; exit 1; }

# Run a command and report how long it took, the way the rest of forge does.
timed() { # verb cmd...
    local verb="$1"; shift
    local t0=${EPOCHREALTIME/[.,]/} t1 tenths
    "$@" || fail "${verb} failed"
    t1=${EPOCHREALTIME/[.,]/}
    tenths=$(( (t1 - t0) / 100000 ))
    ok "${verb} in $(( tenths / 10 )).$(( tenths % 10 )) s"
}

have() { command -v "$1" >/dev/null 2>&1; }

pkg() { # pamac verb, pacman fallback args...
    local verb="$1"; shift
    if have pamac; then
        pamac "${verb}" "$@"
    else
        case "${verb}" in
            install) sudo pacman -S --needed "$@" ;;
            remove)  sudo pacman -Rns "$@" ;;
            upgrade) sudo pacman -Syu ;;
            search)  pacman -Ss "$@" ;;
        esac
    fi
}

kwin_reconfigure() {
    local q
    for q in qdbus6 qdbus; do
        if have "${q}"; then "${q}" org.kde.KWin /KWin reconfigure >/dev/null 2>&1; return; fi
    done
}

# Glass looks: settings for KWin's Glass effect ([Effect-blurplus] in
# kwinrc). They differ in how much the background bends near the edges: calm
# is plain frosted glass with only a hint of it, liquid (the default, as in
# /etc/skel/.config/kwinrc) bends it gently, bold more, and inside the pane
# too. None draws a coloured border: the glass runs right to the edge.
declare -A GLASS=(
    [calm]="BlurStrength=11 DecorationBlurStrength=11 DockBlurStrength=11 Saturation=1.8
            RefractionEdgeSize=1.2 RefractionStrength=5 RefractionBevelIntensity=5
            RefractionRGBFringing=0 BodyRefraction=false RimSpecular=false"
    [liquid]="BlurStrength=7 DecorationBlurStrength=7 DockBlurStrength=8 Saturation=1.7
              RefractionEdgeSize=2.5 RefractionStrength=10 RefractionBevelIntensity=7
              RefractionRGBFringing=0 BodyRefraction=false RimSpecular=false"
    [bold]="BlurStrength=6 DecorationBlurStrength=6 DockBlurStrength=8 Saturation=1.7
            RefractionEdgeSize=3 RefractionStrength=12 RefractionBevelIntensity=8
            RefractionRGBFringing=0 BodyRefraction=true BodyRefractionReach=30
            BodyRefractionStrength=12 RimSpecular=false"
)

# Reload the Glass effect so new settings show at once.
glass_reload() {
    have qdbus6 || return
    qdbus6 org.kde.KWin /KWin reconfigure >/dev/null 2>&1
    qdbus6 org.kde.KWin /Effects unloadEffect glass >/dev/null 2>&1
    qdbus6 org.kde.KWin /Effects loadEffect glass >/dev/null 2>&1
}

usage() {
    cat <<EOF
${BOLD}forge${OFF} ${GREY}— one command for forge-os${OFF}

  ${PERI}install${OFF} <pkg...>    install packages ${GREY}(repos, Chaotic-AUR, AUR)${OFF}
  ${PERI}remove${OFF} <pkg...>     remove packages
  ${PERI}update${OFF}              update everything ${GREY}(packages + Flatpaks)${OFF}
  ${PERI}search${OFF} <query>      find packages
  ${PERI}theme${OFF} [light|dark|name] switch the look ${GREY}(forge theme list)${OFF}
  ${PERI}tile${OFF} [on|off]       auto-tiling windows
  ${PERI}glass${OFF} [preset]      glass look ${GREY}(calm, liquid, bold)${OFF}
  ${PERI}thermal${OFF} [profile]   CPU/GPU clock limits ${GREY}(silent, cool, balanced, performance)${OFF}
  ${PERI}about${OFF}               this system, briefly
EOF
}

cmd="${1:-help}"; shift || true
case "${cmd}" in
    install|add|i)
        [[ $# -gt 0 ]] || fail "install what? e.g. ${PERI}forge install obs-studio${OFF}"
        say "install ${LILAC}$*${OFF}"
        timed installed pkg install "$@"
        ;;
    remove|rm|uninstall)
        [[ $# -gt 0 ]] || fail "remove what?"
        say "remove ${LILAC}$*${OFF}"
        timed removed pkg remove "$@"
        ;;
    update|upgrade|up)
        say "update"
        timed "packages updated" pkg upgrade
        if have flatpak && [[ -n "$(flatpak list --app 2>/dev/null)" ]]; then
            timed "flatpaks updated" flatpak update -y
        fi
        ;;
    search|s)
        [[ $# -gt 0 ]] || fail "search for what?"
        pkg search "$@"
        ;;
    theme)
        # With the Theming Kit, every theme goes through it, so the Forge
        # apps' colours (~/.config/forge/theme.json) stay in step.
        if have forge-themekit; then
            want="${1:-}"
            if [[ "${want}" == list ]]; then
                forge-themekit --list 2>/dev/null | while IFS=$'\t' read -r id name; do
                    printf '  %s%-20s%s %s\n' "${PERI}" "${id}" "${OFF}" "${name}"
                done
                exit 0
            fi
            if [[ -z "${want}" ]]; then
                grep -q '"dark": false' "${XDG_CONFIG_HOME:-$HOME/.config}/forge/theme.json" 2>/dev/null \
                    && want=dark || want=light
                [[ -f "${XDG_CONFIG_HOME:-$HOME/.config}/forge/theme.json" ]] || {
                    [[ "$(kreadconfig6 --file kdeglobals --group General --key ColorScheme)" == *Light* ]] \
                        && want=dark || want=light; }
            fi
            case "${want}" in
                light) want=forge-glass-light ;;
                dark)  want=forge-glass ;;
            esac
            forge-themekit --apply "${want}" >/dev/null 2>&1 \
                || fail "no theme ${PERI}${want}${OFF} ${GREY}(forge theme list)${OFF}"
            ok "theme ${want}"
            exit 0
        fi
        have plasma-apply-lookandfeel || fail "needs a Plasma session"
        current="$(kreadconfig6 --file kdeglobals --group KDE --key LookAndFeelPackage 2>/dev/null)"
        want="${1:-}"
        if [[ -z "${want}" ]]; then
            [[ "${current}" == "org.forgeos.glass.dark" ]] && want=light || want=dark
        fi
        case "${want}" in
            light) lnf=org.forgeos.glass ;;
            dark)  lnf=org.forgeos.glass.dark ;;
            *) fail "theme is ${PERI}light${OFF} or ${PERI}dark${OFF}" ;;
        esac
        plasma-apply-lookandfeel -a "${lnf}" >/dev/null || fail "couldn't apply ${lnf}"
        ok "Forge Glass ${want}"
        ;;
    thermal|temp)
        have forge-thermal || fail "forge-thermal is missing"
        if [[ $# -eq 0 ]]; then
            declare -A st=()
            while IFS='=' read -r k v; do st[$k]="$v"; done < <(forge-thermal status)
            say "thermal ${LILAC}${st[profile]}${OFF} ${GREY}(CPU ${st[profile_cpu_percent]}% · GPU ${st[profile_gpu_percent]}%)${OFF}"
            [[ -n "${st[cpu_temp_c]:-}" ]] && printf '  CPU  %s°C  %s MHz, limit %s MHz\n' "${st[cpu_temp_c]}" \
                "$(( ${st[cpu_clock_khz]:-0} / 1000 ))" "$(( ${st[cpu_cap_khz]:-0} / 1000 ))"
            [[ -n "${st[gpu_temp_c]:-}" ]] && printf '  GPU  %s°C  %s MHz  %s\n' "${st[gpu_temp_c]}" \
                "${st[gpu_clock_mhz]:-?}" "${GREY}${st[gpu_name]:-}${OFF}"
            printf '%sprofiles:%s %s\n' "${GREY}" "${OFF}" "$(forge-thermal list | cut -f1 | tr '\n' ' ')"
        else
            pkexec /usr/local/bin/forge-thermal apply "$1" || fail "couldn't apply ${1}"
            ok "thermal profile ${1}"
        fi
        ;;
    tile)
        have kwriteconfig6 || fail "needs a Plasma session"
        current="$(kreadconfig6 --file kwinrc --group Plugins --key poloniumEnabled --default false)"
        want="${1:-}"
        if [[ -z "${want}" ]]; then
            [[ "${current}" == "true" ]] && want=off || want=on
        fi
        case "${want}" in
            on)  kwriteconfig6 --file kwinrc --group Plugins --key poloniumEnabled true ;;
            off) kwriteconfig6 --file kwinrc --group Plugins --key poloniumEnabled false ;;
            *) fail "tile is ${PERI}on${OFF} or ${PERI}off${OFF}" ;;
        esac
        kwin_reconfigure
        ok "tiling ${want}"
        ;;
    glass)
        have kwriteconfig6 || fail "needs a Plasma session"
        current="$(kreadconfig6 --file forgerc --group Glass --key preset --default liquid)"
        if [[ $# -eq 0 ]]; then
            say "glass ${LILAC}${current}${OFF} ${GREY}(calm, liquid, bold)${OFF}"
            exit 0
        fi
        [[ -n "${GLASS[$1]:-}" ]] || fail "glass is ${PERI}calm${OFF}, ${PERI}liquid${OFF} or ${PERI}bold${OFF}"
        for kv in ${GLASS[$1]}; do
            kwriteconfig6 --file kwinrc --group Effect-blurplus --key "${kv%%=*}" "${kv#*=}"
        done
        kwriteconfig6 --file forgerc --group Glass --key preset "$1"
        glass_reload
        ok "glass $1"
        ;;
    about|info)
        printf '%sForge%s %sOS%s  %s%s · %s · %s%s\n' "${BOLD}" "${OFF}" "${GREY}" "${OFF}" \
            "${GREY}" "$(uname -r)" "$(uname -m)" "${XDG_CURRENT_DESKTOP:-tty}" "${OFF}"
        printf '%sBuilt hot. Runs cool.%s\n' "${LILAC}" "${OFF}"
        ;;
    help|-h|--help) usage ;;
    *) usage; exit 1 ;;
esac
