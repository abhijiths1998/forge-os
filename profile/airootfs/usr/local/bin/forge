#!/usr/bin/env bash
# forge: one command for the everyday stuff on forge-os.
#
#   forge install <pkg...>    repo, Chaotic-AUR and AUR packages (via pamac)
#   forge remove <pkg...>
#   forge update              system packages + Flatpaks
#   forge search <query>
#   forge theme [light|dark|<theme>|list|sync|status]
#                             Forge Glass light/dark (toggles if omitted), or any
#                             Theming Kit theme; sync puts it on the login screen,
#                             shell, GTK/GNOME and Flatpak apps too (status: where)
#   forge tile [on|off|all on|all off]
#                             tiling for this workspace (toggles if omitted);
#                             `all` sets it for every workspace
#   forge glass [preset]      glass look: calm, liquid or bold (shows it if omitted)
#   forge thermal [profile]   CPU/GPU clock profile (shows temps if omitted)
#   forge find <request>      find files: "the pdf from march", "big videos"
#   forge space [cleanup]     what's using the disk, and what could go
#   forge about
set -uo pipefail

# Forge Glass palette, truecolour.
c() { printf '\e[38;2;%sm' "$1"; }
PERI="$(c '138;155;247')" GREEN="$(c '143;211;168')" ROSE="$(c '242;139;155')"
GREY="$(c '139;144;176')" LILAC="$(c '195;183;238')" BOLD=$'\e[1m' OFF=$'\e[0m'
# The Forge theme's colours instead, once forge-theme-sync has written them.
FORGE_THEME_SH="${XDG_CONFIG_HOME:-$HOME/.config}/forge/theme.sh"
# shellcheck source=/dev/null
if [[ -r "${FORGE_THEME_SH}" ]] && source "${FORGE_THEME_SH}" 2>/dev/null; then
    PERI="$(c "${FORGE_ACCENT_RGB:-138;155;247}")" LILAC="$(c "${FORGE_ACCENT_SOFT_RGB:-195;183;238}")"
    GREY="$(c "${FORGE_DIM_RGB:-139;144;176}")" ROSE="$(c "${FORGE_ERROR_RGB:-242;139;155}")"
    GREEN="$(c "${FORGE_OK_RGB:-143;211;168}")"
fi

say()  { printf '%s%s%s %s\n' "${PERI}" "forge" "${OFF}" "$*"; }
ok()   { printf '%s✓%s %s\n' "${GREEN}" "${OFF}" "$*"; }
fail() { printf '%s✗%s %s\n' "${ROSE}" "${OFF}" "$*" >&2; exit 1; }

# Run a command and report how long it took, the way the rest of forge does.
timed() { # verb cmd...
    local verb="$1"; shift
    local t0=${EPOCHREALTIME/[.,]/} t1 tenths
    "$@" || fail "${verb} failed"
    t1=${EPOCHREALTIME/[.,]/}
    tenths=$(( (t1 - t0) / 100000 ))
    ok "${verb} in $(( tenths / 10 )).$(( tenths % 10 )) s"
}

have() { command -v "$1" >/dev/null 2>&1; }

pkg() { # pamac verb, pacman fallback args...
    local verb="$1"; shift
    if have pamac; then
        pamac "${verb}" "$@"
    else
        case "${verb}" in
            install) sudo pacman -S --needed "$@" ;;
            remove)  sudo pacman -Rns "$@" ;;
            upgrade) sudo pacman -Syu ;;
            search)  pacman -Ss "$@" ;;
        esac
    fi
}

# A change to the Forge theme file (~/.config/forge/theme.json): keys and
# values as JSON, merged in. forged sees the file change and runs
# forge-theme-sync, which reloads Hyprland and themes GTK and Qt.
THEME_JSON="${XDG_CONFIG_HOME:-$HOME/.config}/forge/theme.json"
theme_set() {
    python3 - "${THEME_JSON}" "$1" <<'PY'
import json, sys
from pathlib import Path
path, change = Path(sys.argv[1]), json.loads(sys.argv[2])
try:
    theme = json.loads(path.read_text())
except (OSError, ValueError):
    theme = {"id": "forge-glass", "name": "Forge Glass"}
theme.update(change)
path.parent.mkdir(parents=True, exist_ok=True)
tmp = path.with_suffix(".tmp")
tmp.write_text(json.dumps(theme, indent=2) + "\n")
tmp.replace(path)
PY
    have forge-theme-sync && forge-theme-sync --no-login >/dev/null 2>&1
}

# Glass looks, in the Theming Kit's terms (theme.json). Hyprland has no
# refraction, so the lens shows as a lit edge (forge-session's theme.lua):
# calm is plain frosted glass with the faintest edge, liquid (the default)
# a gentle one, bold a brighter one and a stronger blur.
declare -A GLASS=(
    [calm]='{"glassPreset": "calm", "blur": 11, "saturation": 1.8, "lensWidth": 1.2, "lensStrength": 5}'
    [liquid]='{"glassPreset": "liquid", "blur": 7, "saturation": 1.7, "lensWidth": 2.5, "lensStrength": 10}'
    [bold]='{"glassPreset": "bold", "blur": 6, "saturation": 1.9, "lensWidth": 3, "lensStrength": 14}'
)

usage() {
    cat <<EOF
${BOLD}forge${OFF} ${GREY}— one command for forge-os${OFF}

  ${PERI}install${OFF} <pkg...>    install packages ${GREY}(repos, Chaotic-AUR, AUR)${OFF}
  ${PERI}remove${OFF} <pkg...>     remove packages
  ${PERI}update${OFF}              update everything ${GREY}(packages + Flatpaks)${OFF}
  ${PERI}search${OFF} <query>      find packages
  ${PERI}theme${OFF} [light|dark|name] switch the look ${GREY}(list; sync and status: everywhere else)${OFF}
  ${PERI}tile${OFF} [on|off|all ..] tiling for this workspace ${GREY}(all on|off: every one)${OFF}
  ${PERI}glass${OFF} [preset]      glass look ${GREY}(calm, liquid, bold)${OFF}
  ${PERI}thermal${OFF} [profile]   CPU/GPU clock limits ${GREY}(silent, cool, balanced, performance)${OFF}
  ${PERI}keys${OFF} [list|set <cat> <desc> <key>]  list or rebind shortcuts ${GREY}(writes ~/.config/hypr/keybinds.user.lua)${OFF}
  ${PERI}find${OFF} <request>       find files ${GREY}("the pdf from march", "big videos")${OFF}
  ${PERI}space${OFF} [cleanup]     what's using the disk, and what could go
  ${PERI}about${OFF}               this system, briefly
EOF
}

cmd="${1:-help}"; shift || true
case "${cmd}" in
    install|add|i)
        [[ $# -gt 0 ]] || fail "install what? e.g. ${PERI}forge install obs-studio${OFF}"
        say "install ${LILAC}$*${OFF}"
        timed installed pkg install "$@"
        ;;
    remove|rm|uninstall)
        [[ $# -gt 0 ]] || fail "remove what?"
        say "remove ${LILAC}$*${OFF}"
        timed removed pkg remove "$@"
        ;;
    update|upgrade|up)
        say "update"
        timed "packages updated" pkg upgrade
        if have flatpak && [[ -n "$(flatpak list --app 2>/dev/null)" ]]; then
            timed "flatpaks updated" flatpak update -y
        fi
        ;;
    search|s)
        [[ $# -gt 0 ]] || fail "search for what?"
        pkg search "$@"
        ;;
    theme)
        case "${1:-}" in
            sync)   have forge-theme-sync || fail "forge-theme-sync is missing"
                    forge-theme-sync; exit $? ;;
            status) have forge-theme-sync || fail "forge-theme-sync is missing"
                    forge-theme-sync --status; exit $? ;;
        esac
        # With the Theming Kit, every theme goes through it, so the Forge
        # apps' colours (~/.config/forge/theme.json) stay in step.
        if have forge-themekit; then
            want="${1:-}"
            if [[ "${want}" == list ]]; then
                forge-themekit --list 2>/dev/null | while IFS=$'\t' read -r id name; do
                    printf '  %s%-20s%s %s\n' "${PERI}" "${id}" "${OFF}" "${name}"
                done
                exit 0
            fi
            if [[ -z "${want}" ]]; then
                grep -q '"dark": false' "${XDG_CONFIG_HOME:-$HOME/.config}/forge/theme.json" 2>/dev/null \
                    && want=dark || want=light
            fi
            case "${want}" in
                light) want=forge-glass-light ;;
                dark)  want=forge-glass ;;
            esac
            forge-themekit --apply "${want}" >/dev/null 2>&1 \
                || fail "no theme ${PERI}${want}${OFF} ${GREY}(forge theme list)${OFF}"
            ok "theme ${want}"
            exit 0
        fi
        # Without the Theming Kit: Forge Glass, light or dark.
        want="${1:-}"
        if [[ -z "${want}" ]]; then
            grep -q '"dark": false' "${THEME_JSON}" 2>/dev/null && want=dark || want=light
        fi
        case "${want}" in
            light) theme_set '{"dark": false, "accent": "#6C7CF0"}' ;;
            dark)  theme_set '{"dark": true, "accent": "#7F8EF5"}' ;;
            *) fail "theme is ${PERI}light${OFF} or ${PERI}dark${OFF} (the Theming Kit has the rest)" ;;
        esac
        ok "Forge Glass ${want}"
        ;;
    thermal|temp)
        have forge-thermal || fail "forge-thermal is missing"
        if [[ $# -eq 0 ]]; then
            declare -A st=()
            while IFS='=' read -r k v; do st[$k]="$v"; done < <(forge-thermal status)
            say "thermal ${LILAC}${st[profile]}${OFF} ${GREY}(CPU ${st[profile_cpu_percent]}% · GPU ${st[profile_gpu_percent]}%)${OFF}"
            [[ -n "${st[cpu_temp_c]:-}" ]] && printf '  CPU  %s°C  %s MHz, limit %s MHz\n' "${st[cpu_temp_c]}" \
                "$(( ${st[cpu_clock_khz]:-0} / 1000 ))" "$(( ${st[cpu_cap_khz]:-0} / 1000 ))"
            [[ -n "${st[gpu_temp_c]:-}" ]] && printf '  GPU  %s°C  %s MHz  %s\n' "${st[gpu_temp_c]}" \
                "${st[gpu_clock_mhz]:-?}" "${GREY}${st[gpu_name]:-}${OFF}"
            printf '%sprofiles:%s %s\n' "${GREY}" "${OFF}" "$(forge-thermal list | cut -f1 | tr '\n' ' ')"
        else
            pkexec /usr/local/bin/forge-thermal apply "$1" || fail "couldn't apply ${1}"
            ok "thermal profile ${1}"
        fi
        ;;
    tile)
        have forged || fail "forged is missing"
        case "${1:-toggle}" in
            on|off|toggle)
                forged set tiling "${1:-toggle}" || exit 1
                state="$(forged state | python3 -c 'import json,sys; t=json.load(sys.stdin)["tiling"]; print(("on" if t["enabled"] else "off") + " for workspace " + str(t["workspace"]))')"
                ok "tiling ${state}" ;;
            all)
                [[ "${2:-}" == on || "${2:-}" == off ]] || fail "forge tile all ${PERI}on${OFF}|${PERI}off${OFF}"
                state_file="${XDG_STATE_HOME:-$HOME/.local/state}/forge/tiling.json"
                python3 - "${state_file}" "$2" <<'PY'
import json, sys
from pathlib import Path
path = Path(sys.argv[1])
path.parent.mkdir(parents=True, exist_ok=True)
path.write_text(json.dumps({"default": sys.argv[2] == "on", "workspaces": {}}, indent=2) + "\n")
PY
                hyprctl eval 'forge.tiling.reload()' >/dev/null 2>&1
                ok "tiling ${2} on every workspace" ;;
            *) fail "tile is ${PERI}on${OFF}, ${PERI}off${OFF} or ${PERI}all on|off${OFF}" ;;
        esac
        ;;
    glass)
        current="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("glassPreset", "liquid"))' "${THEME_JSON}" 2>/dev/null || echo liquid)"
        if [[ $# -eq 0 ]]; then
            say "glass ${LILAC}${current}${OFF} ${GREY}(calm, liquid, bold)${OFF}"
            exit 0
        fi
        [[ -n "${GLASS[$1]:-}" ]] || fail "glass is ${PERI}calm${OFF}, ${PERI}liquid${OFF} or ${PERI}bold${OFF}"
        theme_set "${GLASS[$1]}"
        ok "glass $1"
        ;;
    find)
        have forge-mind || fail "forge-mind is missing"
        [[ $# -gt 0 ]] || fail "find what?"
        forge-mind ask --deep "$@"
        ;;
    keys)
        # List and rebind keybinds from hyprctl binds -j. A rebind writes
        # ~/.config/hypr/keybinds.user.lua (loaded after keybinds.lua, so the
        # user's overrides win) and reloads Hyprland's config. A key already
        # in use is a conflict and is rejected.
        case "${1:-}" in
            list|'')
                have hyprctl || fail "hyprctl isn't running"
                hyprctl binds -j | python3 - <<'PY'
import json, re, sys
try:
    binds = json.load(sys.stdin)
except Exception:
    sys.exit(0)
by_cat = {}
for b in binds:
    if not isinstance(b, dict): continue
    desc = b.get('description') or ''
    cat, text = 'Other', desc
    m = re.match(r'^\[([^\]]+)\]\s*(.*)$', desc)
    if m:
        cat, text = m.group(1), m.group(2)
    by_cat.setdefault(cat, []).append((text, b.get('keys') or ''))
for cat in sorted(by_cat):
    print(f'== {cat}')
    for text, keys in by_cat[cat]:
        print(f'  {keys:24}  {text}')
    print()
PY
                ;;
            set|rebind)
                [[ $# -eq 3 ]] || fail "usage: forge keys set <category> <description> <new-key>"
                want_cat="$1"; want_desc="$2"; newkey="$3"
                have hyprctl || fail "hyprctl isn't running"
                # Ask python to find the bind, check conflicts, and print
                #   oldkey OK
                # or
                #   oldkey CONFLICT <owner-description>
                # or exit 1 when there's no such bind.
                result="$(hyprctl binds -j | python3 - "$want_cat" "$want_desc" "$newkey" <<'PY'
import json, re, sys
cat, desc, newkey = sys.argv[1], sys.argv[2], sys.argv[3]
try:
    binds = json.load(sys.stdin)
except Exception:
    sys.exit(1)
for b in binds:
    if not isinstance(b, dict): continue
    d = b.get('description') or ''
    m = re.match(r'^\[([^\]]+)\]\s*(.*)$', d)
    if m and m.group(1) == cat and m.group(2) == desc:
        old = b.get('keys') or ''
        for b2 in binds:
            if not isinstance(b2, dict): continue
            k2 = b2.get('keys') or ''
            if k2 == newkey and k2 != old:
                d2 = b2.get('description') or ''
                print(f'{old} CONFLICT {d2}')
                sys.exit(0)
        print(f'{old} OK')
        sys.exit(0)
sys.exit(1)
PY
)"
                status="${result##* }"
                oldkey="${result%% *}"
                case "${status}" in
                    CONFLICT)
                        owner="${result#* }"; owner="${owner#* }"
                        fail "keybind conflict: $newkey is already used by ${owner}"
                        ;;
                    OK)
                        ;;
                    *)
                        fail "no such bind: [$want_cat] $want_desc"
                        ;;
                esac
                hyprctl keyword unbind "${oldkey}" >/dev/null 2>&1 || true
                hyprctl keyword bind "${newkey}" exec "${want_desc}" >/dev/null 2>&1 || true
                mkdir -p "${XDG_CONFIG_HOME:-$HOME/.config}/hypr"
                cat > "${XDG_CONFIG_HOME:-$HOME/.config}/hypr/keybinds.user.lua" <<LUA
-- Keybinds rewritten by Forge Settings (\`forge keys\`).
-- Loaded after keybinds.lua, so these overrides win.
hl.unbind("${oldkey}")
hl.bind("${newkey}", hl.dsp.exec_cmd("${want_desc}"),
    { description = "[${want_cat}] ${want_desc}" })
LUA
                hyprctl reload >/dev/null 2>&1 || true
                ok "keybind [$want_cat] $want_desc is now $newkey"
                ;;
            *)
                usage; exit 1 ;;
        esac
        ;;
    space|disk)
        have forge-mind || fail "forge-mind is missing"
        case "${1:-}" in
            "")      forge-mind stats ;;
            cleanup) forge-mind cleanup ;;
            clean)   shift; forge-mind clean "$@" ;;
            *) fail "space is ${PERI}cleanup${OFF} or ${PERI}clean${OFF} <path...>" ;;
        esac
        ;;
    about|info)
        printf '%sForge%s %sOS%s %s  %s%s · %s · %s%s\n' "${BOLD}" "${OFF}" "${GREY}" "${OFF}" \
            "$(forge-os-release 2>/dev/null)" \
            "${GREY}" "$(uname -r)" "$(uname -m)" "${XDG_CURRENT_DESKTOP:-tty}" "${OFF}"
        printf '%sBuilt hot. Runs cool.%s\n' "${LILAC}" "${OFF}"
        ;;
    help|-h|--help) usage ;;
    *) usage; exit 1 ;;
esac
