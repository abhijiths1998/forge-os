# Arch's filesystem package owns /usr/lib/os-release and puts Arch's back on
# every update; this puts Forge OS's back after it.
[Trigger]
Operation = Install
Operation = Upgrade
Type = Package
Target = filesystem

[Action]
Description = Writing Forge OS's os-release...
When = PostTransaction
Exec = /usr/local/bin/forge-os-release --write
