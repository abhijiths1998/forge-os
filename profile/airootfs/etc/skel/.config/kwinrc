# Three workspaces in a row; Meta+W (or the overview gesture) shows them all.
[Desktops]
Number=3
Rows=1

# Glass: kwin-effects-glass replaces the stock blur (the two conflict, as
# does the stock contrast effect) and frosts everything translucent:
# windows (Darkly + the ForgeGlass colour schemes give them alpha),
# titlebars, menus, panels and Konsole. Rounded window corners come from
# kwin-effect-rounded-corners-git. Polonium auto-tiling is installed but
# off; `forge tile on` turns it on.
[Plugins]
blurEnabled=false
contrastEnabled=false
glassEnabled=true
kwin4_effect_shapecornersEnabled=true
poloniumEnabled=false

# Slider units, as in the effect's settings page. Corner radii match
# [Round-Corners] Size below and Darkly's CornerRadius (darklyrc), so the
# frost never pokes out past a rounded corner.
#
# Liquid glass, kept natural: a clear, saturated blur that runs right to the
# window's edge, where the background bends gently (RefractionEdgeSize is
# x10 px, so 25px). Nothing draws a coloured border: no edge lighting, rim
# light or colour fringing, and the rounded-corners outlines are off. No
# whole-pane bending or noise and a low bevel, either: stronger, those read
# as smeared, shaded edges. `forge glass calm|liquid|bold` switches looks;
# this is liquid.
[Effect-blurplus]
BlurStrength=7
DecorationBlurStrength=7
DockBlurStrength=8
NoiseStrength=0
DockNoiseStrength=0
BlurDecorations=true
BlurMenus=true
BlurDocks=true
Saturation=1.7
Brightness=1.0
TopCornerRadius=14
BottomCornerRadius=14
MenuCornerRadius=10
DockCornerRadius=18
UseDeclaredCornerRadius=false
EdgeLighting=false
EdgeLightingDock=false
EdgeLightingTooltip=false
RefractionStrength=10
RefractionEdgeSize=2.5
RefractionNormalPow=4
RefractionRGBFringing=0
RefractionBevelIntensity=7
BodyRefraction=false
RimSpecular=false

# Rounded corners only: no outlines (the effect's defaults draw a black and
# a white one), so the glass runs to the edge.
[Round-Corners]
Size=14
InactiveCornerRadius=14
OutlineThickness=0
InactiveOutlineThickness=0
SecondOutlineThickness=0
InactiveSecondOutlineThickness=0
