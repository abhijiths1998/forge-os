# Three workspaces in a row; Meta+W (or the overview gesture) shows them all.
[Desktops]
Number=3
Rows=1

# Glass: kwin-effects-glass replaces the stock blur (the two conflict, as
# does the stock contrast effect) and frosts everything translucent:
# windows (Darkly + the ForgeGlass colour schemes give them alpha),
# titlebars, menus, panels and Konsole. Rounded window corners come from
# kwin-effect-rounded-corners-git. Polonium auto-tiling is installed but
# off; `forge tile on` turns it on.
[Plugins]
blurEnabled=false
contrastEnabled=false
glassEnabled=true
kwin4_effect_shapecornersEnabled=true
poloniumEnabled=false

# Slider units, as in the effect's settings page. Corner radii match
# [Round-Corners] Size below and Darkly's CornerRadius (darklyrc), so the
# frost never pokes out past a rounded corner.
#
# Liquid glass: a lighter blur than plain frost so the background stays
# readable through the glass, strong edge refraction with a little colour
# fringing, body refraction (the whole pane bends what's behind it, not just
# the rim) and a specular highlight on the rim.
[Effect-blurplus]
BlurStrength=8
DecorationBlurStrength=8
DockBlurStrength=10
NoiseStrength=1
DockNoiseStrength=1
BlurDecorations=true
BlurMenus=true
BlurDocks=true
Saturation=1.6
Brightness=1.06
TopCornerRadius=14
BottomCornerRadius=14
MenuCornerRadius=10
DockCornerRadius=16
UseDeclaredCornerRadius=false
EdgeLighting=true
EdgeLightingDock=true
EdgeLightingTooltip=true
RefractionStrength=14
RefractionEdgeSize=5
RefractionNormalPow=4
RefractionRGBFringing=4
RefractionBevelIntensity=13
BodyRefraction=true
BodyRefractionReach=40
BodyRefractionStrength=30
RimSpecular=true
RimSpecularScale=12

[Round-Corners]
Size=14
InactiveCornerRadius=14
