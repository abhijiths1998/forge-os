# Darkly: the widget style and window decoration (set in the
# org.forgeos.glass look-and-feel package). Windows go translucent because
# the ForgeGlass colour schemes give their backgrounds alpha; KWin's Glass
# effect does the frosting. CornerRadius matches the window corners in
# kwinrc ([Round-Corners] / [Effect-blurplus]).
[Common]
CornerRadius=10
ShadowSize=ShadowVeryLarge
ShadowStrength=90

[Style]
MenuOpacity=58
MenuBarOpacity=48
ToolBarOpacity=48
TabBarOpacity=48
DolphinSidebarOpacity=42
UnifiedTabBarKonsole=true
TabBarAltStyle=true

# OtherCornerRadius is in units of the decoration's small spacing (2px at
# 1x scale): 7 -> 14px, the window corner radius in kwinrc.
[Windeco]
OtherCornerRadius=7
TitleAlignment=AlignCenterFullWidth
DrawTitleBarSeparator=false
BlurTransparentTitleBar=true
DrawBorderOnMaximizedWindows=false
