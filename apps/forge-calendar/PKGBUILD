# Forge Calendar: Forge OS's calendar (Flutter, forge_ui; events as .ics).
# Built from this directory, next to ../forge_ui, by apps/build-packages.sh
# during the ISO build.
pkgname=forge-calendar
pkgver=1.0.0
pkgrel=1
pkgdesc="Forge OS Calendar: month, week, day and agenda; .ics calendars and subscriptions; reminders"
arch=('x86_64')
url="https://github.com/abhijiths1998/forge-os"
license=('GPL-3.0-or-later')
# gdbus (glib2) sends the reminders.
depends=('gtk3' 'glib2')
makedepends=('flutter-bin' 'cmake' 'ninja' 'clang' 'pkgconf')
options=('!strip' '!debug')

build() {
    cd "${startdir}"
    flutter build linux --release --no-tree-shake-icons
}

package() {
    cd "${startdir}"
    install -d "${pkgdir}/usr/lib/${pkgname}" "${pkgdir}/usr/bin"
    cp -r build/linux/x64/release/bundle/. "${pkgdir}/usr/lib/${pkgname}/"
    ln -s "/usr/lib/${pkgname}/forge-calendar" "${pkgdir}/usr/bin/forge-calendar"
    install -Dm644 data/org.forgeos.calendar.desktop \
        "${pkgdir}/usr/share/applications/org.forgeos.calendar.desktop"
    # Hidden at login, for reminders.
    install -Dm644 data/org.forgeos.calendar-autostart.desktop \
        "${pkgdir}/etc/xdg/autostart/org.forgeos.calendar-autostart.desktop"
}
