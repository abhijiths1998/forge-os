[Desktop Entry]
Type=Application
Name=Forge Browser
GenericName=Web Browser
Comment=Browse the web, with ads and trackers blocked
Exec=forge-browser %U
Icon=internet-web-browser
Categories=Network;WebBrowser;
Keywords=web;browser;internet;www;adblock;
MimeType=text/html;application/xhtml+xml;x-scheme-handler/http;x-scheme-handler/https;
StartupNotify=true
StartupWMClass=org.forgeos.browser
Actions=new-window;

[Desktop Action new-window]
Name=New Window
Exec=forge-browser
