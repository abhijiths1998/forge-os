# Forge Thermal: CPU and GPU temperatures, and profiles that keep them down
# (Flutter, forge_ui; the work is forge-thermal's, in the ISO's airootfs).
# Built from this directory, next to ../forge_ui, by apps/build-packages.sh
# during the ISO build.
pkgname=forge-thermal
pkgver=1.0.0
pkgrel=1
pkgdesc="Forge OS Thermal: temperatures, cooling profiles and firmware limits"
arch=('x86_64')
url="https://github.com/abhijiths1998/forge-os"
license=('GPL-3.0-or-later')
# forge-thermal itself, its profiles and polkit action ship in the airootfs.
depends=('gtk3' 'polkit')
makedepends=('flutter-bin' 'cmake' 'ninja' 'clang' 'pkgconf')
options=('!strip' '!debug')

build() {
    cd "${startdir}"
    # Keep the whole icon font (Forge Shot found tree-shaking drops glyphs).
    flutter build linux --release --no-tree-shake-icons
}

package() {
    cd "${startdir}"
    install -d "${pkgdir}/usr/lib/${pkgname}" "${pkgdir}/usr/bin"
    cp -r build/linux/x64/release/bundle/. "${pkgdir}/usr/lib/${pkgname}/"
    # /usr/bin/forge-thermal-app: forge-thermal is the command-line tool.
    ln -s "/usr/lib/${pkgname}/forge-thermal" "${pkgdir}/usr/bin/forge-thermal-app"
    install -Dm644 data/org.forgeos.thermal.desktop \
        "${pkgdir}/usr/share/applications/org.forgeos.thermal.desktop"
}
