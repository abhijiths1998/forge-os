# Forge Control: the Control Center, a glass panel under the top bar
# (Flutter, GTK runner), and the top-bar widgets that replace the tray's:
# its button, Wi-Fi, Bluetooth, Sound and the battery (Plasma widgets). The state
# and switches come from forged (/usr/local/bin/forged, in the ISO profile).
# Built from this directory by apps/build-packages.sh during the ISO build.
pkgname=forge-control
pkgver=1.0.0
pkgrel=1
pkgdesc="Forge OS Control Center: Wi-Fi, Bluetooth, sound, brightness, power and cooling"
arch=('x86_64')
url="https://github.com/abhijiths1998/forge-os"
license=('GPL-3.0-or-later')
# Plus Jakarta Sans ships in /usr/share/fonts with the ISO, not as a package.
depends=('gtk3' 'glib2' 'gtk-layer-shell' 'python-dbus' 'python-gobject'
         'networkmanager' 'bluez-utils' 'wireplumber' 'libpulse'
         'power-profiles-daemon' 'upower')
makedepends=('flutter-bin' 'cmake' 'ninja' 'clang' 'pkgconf')
options=('!strip' '!debug')

build() {
    cd "${startdir}"
    flutter build linux --release
}

package() {
    cd "${startdir}"
    install -d "${pkgdir}/usr/lib/${pkgname}" "${pkgdir}/usr/bin"
    cp -r build/linux/x64/release/bundle/. "${pkgdir}/usr/lib/${pkgname}/"
    ln -s "/usr/lib/${pkgname}/forge-control" "${pkgdir}/usr/bin/forge-control"
    install -Dm644 data/org.forgeos.control.desktop \
        "${pkgdir}/usr/share/applications/org.forgeos.control.desktop"
    install -Dm644 data/org.forgeos.control-autostart.desktop \
        "${pkgdir}/etc/xdg/autostart/org.forgeos.control-autostart.desktop"
    # The top-bar widgets (the Control Center's button, Wi-Fi, Bluetooth,
    # Sound and the battery) and the QML module they share (org.forgeos.panel).
    local file
    while IFS= read -r -d '' file; do
        install -Dm644 "${file}" "${pkgdir}/usr/share/plasma/${file#data/}"
    done < <(find data/plasmoids -type f -print0)
    while IFS= read -r -d '' file; do
        install -Dm644 "${file}" "${pkgdir}/usr/lib/qt6/${file#data/}"
    done < <(find data/qml -type f -print0)
}
