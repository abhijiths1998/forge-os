# Forge Store: browse, install, update and remove software (Flutter UI,
# GTK runner on libpamac). Built from this directory by
# apps/build-packages.sh during the ISO build.
pkgname=forge-store
pkgver=1.0.0
pkgrel=1
pkgdesc="Forge OS software store: repos, Chaotic-AUR and AUR via libpamac"
arch=('x86_64')
url="https://github.com/abhijiths1998/forge-os"
license=('GPL-3.0-or-later')
# libjxl (through glycin) decodes AppStream's JPEG XL icons.
depends=('gtk3' 'glib2' 'pamac' 'libjxl' 'glycin')
makedepends=('flutter-bin' 'cmake' 'ninja' 'clang' 'pkgconf')
options=('!strip' '!debug')

build() {
    cd "${startdir}"
    flutter build linux --release
}

package() {
    cd "${startdir}"
    install -d "${pkgdir}/usr/lib/${pkgname}" "${pkgdir}/usr/bin"
    cp -r build/linux/x64/release/bundle/. "${pkgdir}/usr/lib/${pkgname}/"
    ln -s "/usr/lib/${pkgname}/forge-store" "${pkgdir}/usr/bin/forge-store"
    install -Dm644 data/org.forgeos.store.desktop \
        "${pkgdir}/usr/share/applications/org.forgeos.store.desktop"
}
