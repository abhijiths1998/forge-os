# Forge Shell: the Forge desktop's top bar, dock, wallpaper and popups (start
# menu, menus, dialogs, polkit's password prompt) (Flutter, GTK runner,
# gtk-layer-shell, libpolkit-agent-1), on Forge Compositor. The session
# itself (forge-session, forge-dialog) is in the ISO profile.
# Built from this directory by apps/build-packages.sh during the ISO build.
pkgname=forge-shell
pkgver=1.0.0
pkgrel=1
pkgdesc="Forge OS desktop shell: top bar, dock, wallpaper, start menu and dialogs"
arch=('x86_64')
url="https://github.com/abhijiths1998/forge-os"
license=('GPL-3.0-or-later')
# Plus Jakarta Sans ships in /usr/share/fonts with the ISO, not as a package.
depends=('gtk3' 'glib2' 'gtk-layer-shell' 'polkit')
makedepends=('flutter-bin' 'cmake' 'ninja' 'clang' 'pkgconf')
options=('!strip' '!debug')

build() {
    cd "${startdir}"
    flutter build linux --release --no-tree-shake-icons
}

package() {
    cd "${startdir}"
    install -d "${pkgdir}/usr/lib/${pkgname}" "${pkgdir}/usr/bin"
    cp -r build/linux/x64/release/bundle/. "${pkgdir}/usr/lib/${pkgname}/"
    ln -s "/usr/lib/${pkgname}/forge-shell" "${pkgdir}/usr/bin/forge-shell"
}
