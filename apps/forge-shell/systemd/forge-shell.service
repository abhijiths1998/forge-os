[Unit]
Description=Forge shell: the bar, Control Center, notifications and overlays (Quickshell)
Documentation=file:///usr/share/doc/forge-shell/README.md
PartOf=graphical-session.target
After=graphical-session.target
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
ExecStart=/usr/bin/forge-shell run
Restart=on-failure
RestartSec=1
Slice=app-graphical.slice

[Install]
WantedBy=graphical-session.target
