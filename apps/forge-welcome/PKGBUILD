# Forge Welcome: Forge OS first-boot onboarding + Keyboard Dojo
# Built from this directory by apps/build-packages.sh during the ISO build.
pkgname=forge-welcome
pkgver=1.0.0
pkgrel=1
pkgdesc="Forge OS Welcome: first-boot choices and Keyboard Dojo shortcut tutorial"
arch=('x86_64')
url="https://github.com/abhijiths1998/forge-os"
license=('GPL-3.0-or-later')
depends=('gtk3' 'glib2' 'hyprland')
makedepends=('flutter-bin' 'cmake' 'ninja' 'clang' 'pkgconf')
options=('!strip' '!debug')

build() {
    cd "${startdir}"
    # Keep the whole icon font (Forge Shot found tree-shaking drops glyphs).
    flutter build linux --release --no-tree-shake-icons
}

package() {
    cd "${startdir}"
    install -d "${pkgdir}/usr/lib/${pkgname}" "${pkgdir}/usr/bin"
    cp -r build/linux/x64/release/bundle/. "${pkgdir}/usr/lib/${pkgname}/"
    ln -s "/usr/lib/${pkgname}/forge-welcome" "${pkgdir}/usr/bin/forge-welcome"
    install -Dm644 data/org.forgeos.welcome.desktop \
        "${pkgdir}/usr/share/applications/org.forgeos.welcome.desktop"
    install -Dm644 README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"
}
