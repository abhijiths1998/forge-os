# Forge Terminal: Forge OS's terminal (Flutter, forge_ui, xterm; our own
# pseudo-terminals in linux/runner/pty.cc). Built from this directory, next
# to ../forge_ui, by apps/build-packages.sh during the ISO build.
pkgname=forge-terminal
pkgver=1.0.0
pkgrel=1
pkgdesc="Forge OS Terminal: tabs, find and the desktop's own colours"
arch=('x86_64')
url="https://github.com/abhijiths1998/forge-os"
license=('GPL-3.0-or-later')
depends=('gtk3' 'fontconfig')
optdepends=('ttf-jetbrains-mono-nerd: the default font')
provides=('terminal-emulator')
makedepends=('flutter-bin' 'cmake' 'ninja' 'clang' 'pkgconf')
options=('!strip' '!debug')

build() {
    cd "${startdir}"
    flutter build linux --release --no-tree-shake-icons
}

package() {
    cd "${startdir}"
    install -d "${pkgdir}/usr/lib/${pkgname}" "${pkgdir}/usr/bin"
    cp -r build/linux/x64/release/bundle/. "${pkgdir}/usr/lib/${pkgname}/"
    ln -s "/usr/lib/${pkgname}/forge-terminal" "${pkgdir}/usr/bin/forge-terminal"
    install -Dm644 data/org.forgeos.terminal.desktop \
        "${pkgdir}/usr/share/applications/org.forgeos.terminal.desktop"
}
