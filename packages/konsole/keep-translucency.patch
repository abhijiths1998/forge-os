+void MainWindow::changeEvent(QEvent *event)
+{
+    KXmlGuiWindow::changeEvent(event);
+
+    // A new style (the desktop switching between a light and a dark colour
+    // scheme re-polishes every widget) can take WA_TranslucentBackground off
+    // the window, and the terminal is then painted opaque whatever the colour
+    // scheme's opacity. It is only set once, in the constructor, so set it again.
+    switch (event->type()) {
+    case QEvent::StyleChange:
+    case QEvent::PaletteChange:
+    case QEvent::ApplicationPaletteChange:
+        if (WindowSystemInfo::HAVE_TRANSPARENCY && !testAttribute(Qt::WA_TranslucentBackground)) {
+            setAttribute(Qt::WA_TranslucentBackground, true);
+            update();
+        }
+        break;
+    default:
+        break;
+    }
+}
